# Where the PriceHub backend API (backend/, Node + MariaDB) is reachable from the
# Next.js server. The browser only calls this site's own /api/* — Next forwards
# those requests here (see next.config.ts), so the admin cookie stays same-origin.
BACKEND_URL=http://127.0.0.1:4000

# Your live domain, used for Open Graph/social share links and metadata.
NEXT_PUBLIC_SITE_URL=https://pricehub.co.ke

# Contact + M-Pesa payment details are plain constants in src/lib/contact.ts
# (WHATSAPP_NUMBER, MPESA_PAYBILL_NUMBER, STORE_ADDRESS, …) — edit them there,
# not here. There is no live Daraja/STK integration: checkout instructs the
# customer to Send Money on M-Pesa and confirms the order over WhatsApp.
