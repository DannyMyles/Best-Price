# Copy to .env and edit. Loaded automatically by `npm start|dev|run migrate|create-admin|import-catalog`
# Real environment variables always win over this file (handy in production).

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# --- MariaDB -----------------------------------------------------------------
# Either a single URL...
# DATABASE_URL=mysql://pricehub:change-me@127.0.0.1:3306/pricehub
# ...or the individual settings:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pricehub
DB_PASSWORD=change-me
DB_NAME=pricehub

# --- Images ------------------------------------------------------------------
# The existing library, used exactly as-is:  <NN_category>/<Item Name>/<Item Name> - N.jpg
# Only used by `npm run import-catalog` / `import-images` to load the original photo library
IMAGES_ROOT=/home/danny/Desktop/programming/pricehub
# Public base URL of THIS API — used to build absolute image URLs in responses.
PUBLIC_URL=http://localhost:4000
MAX_UPLOAD_MB=6

# --- Web / security ----------------------------------------------------------
# Comma-separated browser origins allowed to call the API (storefront + admin UI).
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=12
# Cookie is Secure by default in production. For a frontend on a *different site*
# than the API use COOKIE_SAMESITE=none (requires HTTPS / COOKIE_SECURE=true).
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Behind nginx/Caddy/a load balancer set this (e.g. 1) so rate limiting sees real client IPs.
# TRUST_PROXY=1

# New-order email alerts (optional). Leave SMTP_HOST / NOTIFY_EMAIL_TO empty to disable.
# NOTIFY_EMAIL_TO=you@example.com,staff@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=an-app-password
# SMTP_FROM="PriceHub Orders <you@example.com>"
# STORE_NAME=PriceHub
